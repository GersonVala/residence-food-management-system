# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/fundacion_db"

# JWT
# Obligatorio en producción: mínimo 32 caracteres, si no el servidor no arranca.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="cambiar-por-un-secreto-seguro-en-produccion"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3001
NODE_ENV=development

# Frontend (CORS) — obligatorio en producción
FRONTEND_URL="http://localhost:3000"

# Email (Mailhog en desarrollo)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@fundacion.local"
