{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://residence-food-management-system.onrender.com/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://residence-food-management-system.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
